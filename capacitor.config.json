{
  "appId": "com.finanza.app",
  "appName": "Finanza",
  "webDir": "frontend",
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "hostname": "app.finanza"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#08090d",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true,
      "fadeInDuration": 200,
      "fadeOutDuration": 200
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#08090d",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body",
      "style": "dark",
      "resizeOnFullScreen": true
    }
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#08090d",
    "minWebViewVersion": 60,
    "appendUserAgent": "Finanza/1.0"
  }
}