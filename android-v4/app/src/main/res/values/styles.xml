<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FinanzaV4" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/finanza_bg</item>
        <item name="android:navigationBarColor">@color/finanza_bg</item>
        <item name="android:windowBackground">@color/finanza_bg</item>
    </style>

    <style name="Theme.FinanzaV4.Launch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/splash_brand</item>
        <item name="windowSplashScreenBackground">@color/finanza_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_animated</item>
        <item name="windowSplashScreenAnimationDuration">320</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.FinanzaV4</item>
    </style>

    <style name="WidgetQuickAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/widget_action_background</item>
        <item name="android:fontFamily">@font/dm_sans_600</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">#C8F55A</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
